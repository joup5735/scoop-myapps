{
    "version": "1.19.3",
    "description": "Multi-platform transparent client-side encryption of files in the cloud",
    "homepage": "https://cryptomator.org",
    "license": "GPL-3.0-only",
    "notes": "Run 'patchWebDAV.bat cryptomator-vault' with administrator privileges.",
    "suggest": {
        "WinFSP": "nonportable/winfsp-np"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/cryptomator/cryptomator/releases/download/1.19.3/Cryptomator-1.19.3-x64.msi",
            "hash": "e303cced835e1a8a1041580eeaea3b7b3658c348d77ea53a108a95926625c41a"
        }
    },
    "extract_dir": "PFiles64/Cryptomator",
    "post_install": [
        "    $cfg = \"$dir\\app\\Cryptomator.cfg\"",
        "    $ReplaceMap = [Ordered]@{",
        "        'C:/ProgramData'            = './data/programdata'",
        "        '@{localappdata}'           = './data/localappdata'",
        "        '@{appdata}'                = './data/appdata'",
        "        '@{userhome}'               = './data/userhome'",
        "        'C:/cryptomator'            = './data/cryptomator'",
        "        'disableUpdateCheck=false'  = 'disableUpdateCheck=true'",
        "    }",
        "    $c = Get-Content $cfg -Encoding UTF8",
        "    $c = $c -replace ';.*', ''",
        "    foreach($p in $ReplaceMap.Keys) { $c = $c -replace [regex]::Escape($p), $ReplaceMap[$p] }",
        "    Set-Content $cfg -Encoding UTF8 -Value $c"
    ],
    "bin": "Cryptomator.exe",
    "shortcuts": [
        [
            "Cryptomator.exe",
            "Cryptomator"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://github.com/cryptomator/cryptomator/releases",
        "regex": "Cryptomator-([\\d.]+)-x64\\.msi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cryptomator/cryptomator/releases/download/$version/Cryptomator-$version-x64.msi"
            }
        },
        "hash": {
            "url": "https://github.com/cryptomator/cryptomator/releases/tag/$version",
            "regex": "$sha256\\s*\\./$basename"
        }
    }
}
